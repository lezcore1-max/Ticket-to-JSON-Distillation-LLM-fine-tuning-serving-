{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TicketLabel",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "category", "urgency", "product", "order_id", "sentiment"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "create_account", "delete_account", "edit_account", "recover_password",
        "registration_problems", "switch_account", "check_cancellation_fee",
        "contact_customer_service", "contact_human_agent", "delivery_options",
        "delivery_period", "complaint", "review", "check_invoice", "get_invoice",
        "cancel_order", "change_order", "place_order", "track_order",
        "check_payment_methods", "payment_issue", "check_refund_policy",
        "get_refund", "track_refund", "change_shipping_address",
        "set_up_shipping_address", "newsletter_subscription"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "account", "cancel", "contact", "delivery", "feedback", "invoice",
        "order", "payment", "refund", "shipping", "subscription"
      ]
    },
    "urgency":   {"type": "string", "enum": ["low", "medium", "high"]},
    "product":   {"type": ["string", "null"], "maxLength": 60},
    "order_id":  {"type": ["string", "null"], "maxLength": 40},
    "sentiment": {"type": "string", "enum": ["negative", "neutral", "positive"]}
  }
}
